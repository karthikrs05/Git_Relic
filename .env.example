# .env.example — copy to .env and fill in real values before starting the server
# Server will NOT load this file automatically; rename to .env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# CORS origin — the URL your Vite dev server runs on
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/git-relic
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/git-relic
MONGODB_URI=mongodb://localhost:27017/git-relic

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#JWT_SECRET=change_me_to_a_long_random_secret

# ── AI Analysis (Google Gemini) ───────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Admin Access ──────────────────────────────────────────────────────────────
# Comma-separated list of email addresses with admin privileges
# Controls access to GET /api/projects/status/pending-review
ADMIN_EMAILS=admin@example.com

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Must be prefixed with VITE_ to be exposed to the browser
VITE_API_BASE_URL=http://localhost:8787/api
